            "default": ""
        },
        "max": {
            "@type": "Number",
            "optional": true,
            "default": 0
        },
        "min": {
            "@type": "Number",
            "optional": true,
            "default": 0
        },
        "halign": {
            "@type": "String",
            "optional": true,
            "default": "center",
            "pattern": "start|end|center"
        },
        "valign": {
            "@type": "String",
            "optional": true,
            "default": "center",
            "pattern": "start|end|center"
        }
    }
}