[
    {
        "type": "Fieldset",
        "label": "Map settings",
        "children": [
            {
                "type": "SwitchInput",
                "name": "map.active",
                "label": "Map active"
            },
            {
                "type": "ColorInput",
                "name": "map.backgroundColor",
                "label": "Background Color",
                "visible": {
                    "type": "value",
                    "ref": "map.active"
                }
            },
            {
                "type": "ImageSelect",
                "id": "mapselect",
                "name": "map.backgroundImage",
                "label": "Background Image",
                "optiongroup": "worldEditor_areaMapImages",
                "visible": {
                    "type": "value",
                    "ref": "map.active"
                }
            },
            {
                "type": "NumberInput",
                "id": "mapwidth",
                "name": "map.width",
                "label": "Width",
                "readonly": true,
                "visible": {
                    "type": "value",
                    "ref": "map.active"
                }
            },
            {
                "type": "NumberInput",
                "id": "mapheight",
                "name": "map.height",
                "label": "Height",
                "readonly": true,
                "visible": {
                    "type": "value",
                    "ref": "map.active"
                }
            },
            {
                "type": "RangeInput",
                "name": "map.zoom",
                "label": "Default Zoom",
                "min": 10,
                "max": 200,
                "gradations": true,
                "visible": {
                    "type": "value",
                    "ref": "map.active"
                }
            }
        ]
    },
    {
        "type": "MarkerListInput",
        "id": "marker-list",
        "name": "list",
        "label": "List",
        "value": []
    }
]
